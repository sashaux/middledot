{
  "manifest_version": 3,
  "name": "middledot",
  "version": "1.0.0",
  "description": "Special characters, one click away: « » – — · → ≠ ± ©. Copy instantly and arrange your own set.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "middledot",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": [
    "clipboardWrite"
  ]
}
